# =====================================================================
# DIZURA — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only and validated in lib/env.ts.
# =====================================================================

# ---- App ----
# Optional. Leave empty locally (-> http://localhost:3000). On Netlify set it for Production only;
# deploy previews / branch deploys use Netlify's DEPLOY_PRIME_URL automatically (lib/app-url.ts).
NEXT_PUBLIC_APP_URL=
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# ---- Database / Auth (Supabase) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/dizura
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret/service-role key — SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Higgsfield (all AI generation, incl. WAN 3.0 Prime video) ----
# From your Higgsfield account's API keys page. Either set both, or put the combined
# "KEY_ID:KEY_SECRET" credential in HIGGSFIELD_API_KEY and leave the secret empty.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Optional override; defaults to https://api.higgsfield.ai
# HIGGSFIELD_API_BASE_URL=

# ---- Google Search Console via MCP (GEO Audit) ----

# ---- Tap Payments ----
TAP_API_BASE_URL=https://api.tap.company/v2
# sk_test_... / sk_live_...  (server only)
TAP_SECRET_KEY=
# pk_test_... / pk_live_...  (safe for browser — card tokenization only)
NEXT_PUBLIC_TAP_PUBLIC_KEY=

# --- Strategy chat + blueprints (Claude API, server-only) ---
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# --- DIZURA Voice (ElevenLabs, server-only) ---
ELEVENLABS_API_KEY=
# Optional: defaults to eleven_multilingual_v2
ELEVENLABS_MODEL_ID=
# ELEVENLABS_API_BASE_URL=
# What 1,000 characters cost on your ElevenLabs plan (USD); keeps voice prices at a 60% margin
ELEVENLABS_USD_PER_1K_CHARS=

# --- Scheduled jobs (subscription renewals + automatic price refresh) ---
# Random 64-char value; set in Netlify (Builds + Functions, secret). Used by netlify/functions/hourly.mts
CRON_SECRET=
