# =====================================================================
# DIZURA — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only and validated in lib/env.ts.
# =====================================================================

# ---- App ----
# Optional. Leave empty locally (-> http://localhost:3000). On Netlify set it for Production only;
# deploy previews / branch deploys use Netlify's DEPLOY_PRIME_URL automatically (lib/app-url.ts).
NEXT_PUBLIC_APP_URL=
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# ---- Database / Auth (Supabase) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/dizura
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret/service-role key — SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Higgsfield (Ads Studio, AI Influencer) ----
HIGGSFIELD_API_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# ---- WAN 3.0 Prime (video) ----
WAN_API_BASE_URL=
WAN_API_KEY=
WAN_MODEL=wan-3.0-prime

# ---- Google Search Console via MCP (GEO Audit) ----
GSC_MCP_ENDPOINT=
GSC_MCP_TOKEN=

# ---- Tap Payments ----
TAP_API_BASE_URL=https://api.tap.company/v2
# sk_test_... / sk_live_...  (server only)
TAP_SECRET_KEY=
# pk_test_... / pk_live_...  (safe for browser — card tokenization only)
NEXT_PUBLIC_TAP_PUBLIC_KEY=
