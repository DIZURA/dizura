{
  "name": "dizura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run scan:secrets",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "photos:options": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/generate-option-photos.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "margins": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-margins.mjs",
    "example:seedance": "node --env-file-if-exists=.env.local --experimental-strip-types examples/seedance/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@higgsfield/client": "0.2.6",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
